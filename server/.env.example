# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tridash?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/tridash?schema=public"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# Firebase Admin SDK (get these values from Firebase Console)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# Preserve the private key's line breaks as literal \n characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mapbox API
MAPBOX_PUBLIC_TOKEN=your-mapbox-token-here

# Paystack API
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
# Platform commission percent on split payments (driver gets the rest). Default: 15
PLATFORM_COMMISSION_PERCENT=15

# Super Admin Email
SUPER_ADMIN_EMAIL=admin@example.com

# Driver verification: keep uploads on private persistent storage (never expose this folder as static files).
DRIVER_DOCUMENT_STORAGE_DIR=./private-uploads/driver-verification
# Required in production: generate with `openssl rand -hex 32`; keep it in the secret manager and back it up securely.
DRIVER_DOCUMENT_ENCRYPTION_KEY=
# Optional OCR adapter. POST JSON {documentType,mimeType,base64}; return {fields:{firstName,lastName,otherNames,dateOfBirth,documentNumber,expiryDate,registrationNumber,vin,make,model}}.
DOCUMENT_OCR_API_URL=
DOCUMENT_OCR_API_KEY=
# Optional authorised official-verification adapters. Identity/licence responses must return verified=true plus matching documentNumber, fullName, and dateOfBirth in data/details. Vehicle responses must return verified=true plus the matching registrationNumber (and VIN/chassis when submitted). Responses missing required matching details fail closed. Face endpoint accepts {selfieBase64,selfieMimeType,identityDocumentBase64,identityDocumentMimeType} and must return faceMatchPassed=true and livenessPassed=true to pass.
FRSC_VERIFICATION_API_URL=
FRSC_VERIFICATION_API_KEY=
GOVERNMENT_ID_VERIFICATION_API_URL=
GOVERNMENT_ID_VERIFICATION_API_KEY=
VEHICLE_REGISTRATION_VERIFICATION_API_URL=
VEHICLE_REGISTRATION_VERIFICATION_API_KEY=
STATE_PERMIT_VERIFICATION_API_URL=
STATE_PERMIT_VERIFICATION_API_KEY=
VEHICLE_INSPECTION_VERIFICATION_API_URL=
VEHICLE_INSPECTION_VERIFICATION_API_KEY=
VEHICLE_INSURANCE_VERIFICATION_API_URL=
VEHICLE_INSURANCE_VERIFICATION_API_KEY=
# If configured, final approval also requires faceStatus=verified. Provider must support liveness/face matching.
FACE_VERIFICATION_API_URL=
FACE_VERIFICATION_API_KEY=

# Optional public URL used in emergency and trip-share links
PUBLIC_APP_URL=http://localhost:5173

# Optional Twilio SMS delivery for emergency contacts
# Without these values, SOS is recorded and active administrators receive
# an in-app alert; no SMS is sent to emergency contacts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
