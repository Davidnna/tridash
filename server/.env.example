# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tridash?schema=public"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# Firebase Admin SDK (get these values from Firebase Console)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# Preserve the private key's line breaks as literal \n characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mapbox API
MAPBOX_PUBLIC_TOKEN=your-mapbox-token-here

# Paystack API
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# Super Admin Email
SUPER_ADMIN_EMAIL=davedozie1@gmail.com
